@startuml
!include style.puml
title Model Component Class Diagram
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model as ModelPackage <<Rectangle>> {
    Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
    Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
    Class "<<interface>>\nModel" as Model
    Class ModelManager
    Class AddressBook
    Class UserPrefs

    Class UniqueStudentList
    Class UniqueGuardianList
    Class UniqueLessonList
    Class StudentGuardianLink
    Class Student
    Class Guardian
    Class Lesson
    Class LessonMatchesDatePredicate
    Class LessonMatchesStudentPredicate
    Class Name
    Class Phone
    Class Email
    Class Address
    Class Level
    Class Subject
    Class Remark
    Class PaymentMonth
}

' Component APIs and their implementations
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs

' AddressBook owns the three main collections and the relationship records.
AddressBook *-- "1" UniqueStudentList
AddressBook *-- "1" UniqueGuardianList
AddressBook *-- "1" UniqueLessonList
AddressBook *-- "0..*" StudentGuardianLink
UniqueStudentList --> "0..*" Student
UniqueGuardianList --> "0..*" Guardian
UniqueLessonList --> "0..*" Lesson

' Lessons belong to students and can be filtered by date or student.
Lesson "0..*" --> "1" Student
LessonMatchesDatePredicate ..> Lesson
LessonMatchesStudentPredicate ..> Lesson
ModelManager ..> LessonMatchesDatePredicate
ModelManager ..> LessonMatchesStudentPredicate

' A link reifies the relationship between a student and a guardian.
StudentGuardianLink "0..*" --> "1" Student
StudentGuardianLink "0..*" --> "1" Guardian

' Students and guardians share contact value objects; students also have
' academic information. Composition indicates that these values form part
' of the entity represented in the model.
Student *-- "1" Name
Student *-- "1" Phone
Student *-- "1" Email
Student *-- "1" Address
Student *-- "1" Level
Student *-- "1..*" Subject
Student *-- "1" Remark
Student *-- "0..*" PaymentMonth

Guardian *-- "1" Name
Guardian *-- "1" Phone
Guardian *-- "1" Email
Guardian *-- "1" Address

@enduml
