@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model as ModelPackage <<Rectangle>> {
Class Student {
  +getPaidMonths(): SortedSet<PaymentMonth>
  +hasPaidFor(paymentMonth: PaymentMonth): boolean
  +withPaymentFor(paymentMonth: PaymentMonth): Student
}

Class PaymentMonth {
  +value: YearMonth
  {static} +isValidPaymentMonth(test: String): boolean
  +toDisplayString(): String
}
}

show Student members
show PaymentMonth members

Class "<<interface>>\nComparable<PaymentMonth>" as Comparable #FFFFFF

Student *--> "*" PaymentMonth : paidMonths
PaymentMonth .up.|> Comparable
@enduml
