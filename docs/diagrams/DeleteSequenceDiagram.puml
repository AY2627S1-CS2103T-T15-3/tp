@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":RemoveStudentCommandParser" as RemoveStudentCommandParser LOGIC_COLOR
participant "r:RemoveStudentCommand" as RemoveStudentCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("remove-s 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("remove-s 1")
activate AddressBookParser

create RemoveStudentCommandParser
AddressBookParser -> RemoveStudentCommandParser
activate RemoveStudentCommandParser

RemoveStudentCommandParser --> AddressBookParser
deactivate RemoveStudentCommandParser

AddressBookParser -> RemoveStudentCommandParser : parse("1")
activate RemoveStudentCommandParser

create RemoveStudentCommand
RemoveStudentCommandParser -> RemoveStudentCommand
activate RemoveStudentCommand

RemoveStudentCommand --> RemoveStudentCommandParser :
deactivate RemoveStudentCommand

RemoveStudentCommandParser --> AddressBookParser : r
deactivate RemoveStudentCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
RemoveStudentCommandParser -[hidden]-> AddressBookParser
destroy RemoveStudentCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> RemoveStudentCommand : execute(m)
activate RemoveStudentCommand

RemoveStudentCommand -> Model : deleteStudent(1)
activate Model

Model --> RemoveStudentCommand
deactivate Model

create CommandResult
RemoveStudentCommand -> CommandResult
activate CommandResult

CommandResult --> RemoveStudentCommand
deactivate CommandResult

RemoveStudentCommand --> LogicManager : r
deactivate RemoveStudentCommand

[<--LogicManager
deactivate LogicManager
@enduml
