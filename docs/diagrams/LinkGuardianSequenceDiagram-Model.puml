@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
participant "studentGuardianLinks:List" as StudentGuardianLinks MODEL_COLOR
end box

[-> ModelManager : addStudentGuardianLink(l)
activate ModelManager

ModelManager -> AddressBook : addStudentGuardianLink(l)
activate AddressBook

AddressBook -> StudentGuardianLinks : contains(l)
activate StudentGuardianLinks
StudentGuardianLinks --> AddressBook : exists
deactivate StudentGuardianLinks

opt link does not already exist
    AddressBook -> StudentGuardianLinks : add(l)
    activate StudentGuardianLinks
    StudentGuardianLinks --> AddressBook
    deactivate StudentGuardianLinks
end

AddressBook --> ModelManager
deactivate AddressBook

[<-- ModelManager
deactivate ModelManager

@enduml
